# ===================================================
# CivicShield AI — Backend environment
# Copy to `.env` and adjust. Never commit the real .env.
# ===================================================

# development | production
ENVIRONMENT=development
DEBUG=false

# ---- Security (REQUIRED in production) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
DATABASE_URL=sqlite:///./civicshield.db

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Scanner safety ----
# Set true ONLY to scan your own local apps in dev. Leave false in production.
ALLOW_PRIVATE_TARGETS=false
SCAN_MAX_PAGES=3
SCAN_REQUEST_TIMEOUT=4.0

# ---- Rate limits (slowapi syntax) ----
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_PHISHING=30/minute
RATE_LIMIT_AUTH=5/minute

# ---- Cold-start keep-warm ----
# Set to the public base URL of this API (e.g. https://your-api.onrender.com)
# to enable an internal self-ping to /health. Leave blank to disable.
KEEP_WARM_URL=
KEEP_WARM_INTERVAL_SECONDS=600

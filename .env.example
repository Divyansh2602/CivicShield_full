# ===================================================
# docker compose environment overrides
# Copy to `.env` and adjust as needed:  cp .env.example .env
# All values have sensible defaults in docker-compose.yml.
# ===================================================

# --- Postgres (the bundled db service) ---
POSTGRES_USER=civicshield
POSTGRES_PASSWORD=civicshield
POSTGRES_DB=civicshield

# --- Backend ---
# Point at the bundled db by default. To use hosted Supabase instead, set e.g.:
#   DATABASE_URL=postgresql://postgres:PASS@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://civicshield:civicshield@db:5432/civicshield

# --- Host port mappings ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend (optional Supabase, safe to leave blank) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
